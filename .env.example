# CapitolPass — every one of these is optional.
#
# The app is designed to run with none of them set: mail goes to a local
# outbox, transit uses a curated station table, and the database is a file.
# Copy to .env.local and fill in only what you need.

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Without these, sign-in links, administrator co-sign links and office claim
# confirmations are written to data/outbox.log, printed to the server console,
# and surfaced directly in the UI in development. Every flow is walkable
# without configuring mail at all.
#
# This is only ever used for transactional mail to people who just asked for
# it. CapitolPass never emails a congressional office on a teacher's behalf.
RESEND_API_KEY=
MAIL_FROM="CapitolPass <noreply@example.org>"

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# Two jobs:
#
#   1. Builds absolute links in email. Defaults to http://localhost:3000, or to
#      VERCEL_URL when deployed on Vercel.
#   2. Decides whether the session cookie carries the `Secure` flag, taken from
#      the scheme above.
#
# That second one matters: if you run a production build over plain HTTP
# (`npm run build && npm start` on localhost) and leave this unset, the cookie
# defaults to Secure and sign-in fails with no visible error. Set it to
# http://localhost:3000 for that case. Unset in production means secure —
# safe by default rather than convenient by default.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The same thing, read at RUNTIME rather than inlined at build time.
#
# NEXT_PUBLIC_* variables are substituted into the compiled output by
# `next build`, so a container built without one has `undefined` baked in and
# setting it in the deployment's environment afterwards changes nothing. That
# breaks redirects on a hosted deployment: sign-in succeeds, sets its cookie,
# and lands the user on http://0.0.0.0:3000/ — a dead link, with nothing in the
# logs.
#
# So a deployment sets this one. Local development can use either. See
# lib/site-url.ts.
CAPITOLPASS_SITE_URL=

# ---------------------------------------------------------------------------
# WMATA (Metro)
# ---------------------------------------------------------------------------
# Free key from https://developer.wmata.com/. Without it the app uses its
# curated table of the stations near the Capitol, which is stable information
# that does not need an API call. Fares are shown as unknown either way —
# they vary by distance and time of day, and a wrong number in a teacher's
# budget is worse than no number.
WMATA_API_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Path to the SQLite file. Defaults to data/capitolpass.db.
CAPITOLPASS_DB=

# ---------------------------------------------------------------------------
# Guided demo
# ---------------------------------------------------------------------------
# Set to 1 to expose /demo/<persona> and the three one-click doors on the
# landing page. They sign in as the seeded demo.* accounts created by
# `npm run db:seed` — no email, no waiting for a link.
#
# This is an endpoint that hands out a session without proving anything, so it
# is opt-in and never inferred from NODE_ENV: an unset flag means 404, and a
# deployment serving real schools simply never sets it. See lib/auth/demo.ts.
CAPITOLPASS_DEMO=
